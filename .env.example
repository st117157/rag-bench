# ШАБЛОН. Настоящий ключ сюда вписывать НЕЛЬЗЯ.
#
# Этот файл коммитится в репозиторий — он нужен тому, кто будет
# разворачивать проект с нуля. Ключ живёт в .env, который в .gitignore.
#
# Как пользоваться:
#   1. скопировать этот файл в .env
#   2. вписать ключ ТУДА
#   3. этот файл не трогать
#
# Проверка перед коммитом: git status не должен показывать .env,
# а в .env.example не должно быть ничего, кроме плейсхолдеров.

OPENAI_API_KEY=sk-впишите-свой-ключ-в-файл-.env-а-не-сюда

# Если хотите Anthropic вместо OpenAI — раскомментируйте эти две строки
# и закомментируйте OPENAI_API_KEY выше.
# OPENAI_API_KEY=sk-ant-...
# OPENAI_BASE_URL=https://api.anthropic.com/v1/
